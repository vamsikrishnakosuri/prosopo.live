# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Hugging Face access token (free): https://huggingface.co/settings/tokens  (type: Read)
HF_TOKEN=

# Optional: override the chat model served via the HF Inference router
# HF_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Optional: Google Gemini free tier (best Telugu). Get a free key at
# https://aistudio.google.com/apikey — when set, Gemini is used instead of HF.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
